{
  "id": "skill-assignment-visibility",
  "title": "The library's switch changes what the next turn sees",
  "behavior": "With features.skillsLibrary on, a turn while the library skill is switched off does not list it; after the Skills surface's switch, the next turn's system prompt carries it as a library skill, for any bot, with no assignment.",
  "issue": 1803,
  "world": "coordination",
  "gates": [],
  "librarySkills": [
    {
      "name": "order-audit",
      "instructions": "---\nname: order-audit\ndescription: Audit every order before it ships.\n---\n\nCheck each line item against the packing slip before shipping anything."
    }
  ],
  "bots": [
    {
      "key": "shop",
      "name": "Shop",
      "turns": [
        { "reply": "Order noted" },
        { "reply": "Order audited" }
      ]
    }
  ],
  "steps": [
    { "kind": "setConfig", "config": { "features": { "skillsLibrary": true } } },
    { "kind": "setLibrarySkillEnabled", "name": "order-audit", "enabled": false },
    { "kind": "send", "bot": "shop", "text": "Handle order 1001." },
    { "kind": "waitForTurns", "bot": "shop", "count": 1, "timeoutMs": 20000 },
    { "kind": "setLibrarySkillEnabled", "name": "order-audit", "enabled": true },
    { "kind": "send", "bot": "shop", "text": "Handle order 1002." },
    { "kind": "waitForTurns", "bot": "shop", "count": 2, "timeoutMs": 20000 }
  ],
  "assertions": [
    { "kind": "systemPromptOmits", "bot": "shop", "turn": 0, "omits": "order-audit" },
    { "kind": "systemPromptIncludes", "bot": "shop", "turn": 1, "includes": "Skills:\n- order-audit (the skills library):" },
    { "kind": "systemPromptOmits", "bot": "shop", "turn": 1, "omits": "Check each line item" }
  ]
}
